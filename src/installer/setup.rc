#include <windows.h>
#include "setup.h"
#include "../version.h"

1 24 "setup.manifest"
200 RCDATA "../TraySense-main/TraySense.exe"
201 RCDATA "pawnio/PawnIO_setup.exe"

IDD_SETUP DIALOGEX 0, 0, 320, 192
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TraySense Setup"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "TraySense", IDC_TITLE, 12, 10, 296, 12
    LTEXT           "Shows CPU, GPU and RAM usage and temperatures on your taskbar. Right-click the labels and choose ""Show on display"" to pick which monitor.",
                    IDC_STATIC_INFO, 12, 24, 296, 20
    LTEXT           "Install to:", IDC_STATIC_DIR, 12, 52, 296, 9
    EDITTEXT        IDC_DIR, 12, 63, 238, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 254, 62, 54, 16
    AUTOCHECKBOX    "Create a &desktop shortcut", IDC_DESKTOP, 12, 88, 296, 10
    AUTOCHECKBOX    "&Start TraySense with Windows", IDC_STARTUP, 12, 102, 296, 10
    AUTOCHECKBOX    "Install &CPU temperature support (PawnIO driver)", IDC_PAWNIO, 12, 116, 296, 10
    AUTOCHECKBOX    "&Launch TraySense when setup finishes", IDC_LAUNCH, 12, 130, 296, 10
    LTEXT           "", IDC_NOTE, 12, 146, 296, 18
    DEFPUSHBUTTON   "&Install", IDOK, 196, 168, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 254, 168, 54, 16
END

1 VERSIONINFO
FILEVERSION TS_VER_MAJOR,TS_VER_MINOR,TS_VER_PATCH,0
PRODUCTVERSION TS_VER_MAJOR,TS_VER_MINOR,TS_VER_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "TraySense Setup"
      VALUE "ProductName", "TraySense"
      VALUE "ProductVersion", TS_VERSION_A
      VALUE "FileVersion", TS_VERSION_A
      VALUE "LegalCopyright", "MIT License, TraySense contributors"
      VALUE "OriginalFilename", "TraySense-Setup.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
